<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title or "City of Promise" }}</title>

<!-- Tell Chromium browsers to prerender same-site pages immediately.
     "eager" means: prerender all matched links as soon as this page loads,
     not on hover-intent. Needed because moderate eagerness waits for a
     heuristic that often doesn't fire before the click on a small site.
     When the user clicks a nav link the page is already loaded → no flash. -->
<script type="speculationrules">
{
  "prerender": [{
    "where": { "and": [
      { "href_matches": "/*" },
      { "not": { "href_matches": "/constellation.html" } },
      { "not": { "href_matches": "/*.pdf" } }
    ]},
    "eagerness": "eager"
  }]
}
</script>

<!-- Plain prefetch fallback for browsers without Speculation Rules support
     (Safari, Firefox). Loads HTML into HTTP cache during idle time so the
     navigation paints from cache instead of from the network. -->
<link rel="prefetch" href="index.html" as="document">
<link rel="prefetch" href="what-we-do.html" as="document">
<link rel="prefetch" href="community-schools.html" as="document">
<link rel="prefetch" href="family-engagement.html" as="document">
<link rel="prefetch" href="our-approach.html" as="document">
<link rel="prefetch" href="who-we-are.html" as="document">
<link rel="prefetch" href="get-involved.html" as="document">
<link rel="prefetch" href="volunteer.html" as="document">

<!-- Paint the page background BEFORE any external CSS loads, to kill the
     white flash between page navigations. Hex must match --color-canvas. -->
<style>html, body { background: #EEEEEC; }</style>
<link rel="icon" href="assets/favicon.png">

<!-- Fonts: preconnect + parallel-load. display=optional means the browser
     uses fallback if Inter/Fraunces aren't ready in <100ms, then uses real
     fonts on subsequent page loads (cached). Avoids the visible "text moves"
     flash when fonts arrive late. -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700&display=optional">

<link rel="stylesheet" href="colors_and_type.css">
<link rel="stylesheet" href="assets/site.css">
{% if extraHead %}{{ extraHead | safe }}{% endif %}
</head>
<body>

{% include "header.njk" %}

{{ content | safe }}

{% include "footer.njk" %}

</body>
</html>
